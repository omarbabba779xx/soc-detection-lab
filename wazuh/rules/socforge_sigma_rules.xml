<group name="socforge,windows,">

  <!-- ============================================================ -->
  <!-- T1046 — Network Service Discovery (Sysmon EventID 3)       -->
  <!-- ============================================================ -->
  <rule id="100101" level="8">
    <if_group>sysmon_event3</if_group>
    <field name="win.eventdata.destinationPort" type="pcre2">^(21|22|23|25|445|1433|3306|3389|5985|5986)$</field>
    <description>Sigma T1046: Network connection to a sensitive/admin port — $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description>
    <group>network_scan,mitre_discovery,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100102" level="10" frequency="10" timeframe="300">
    <if_matched_sid>100101</if_matched_sid>
    <description>Sigma T1046: Multiple ports scanned from the same source — possible port scan</description>
    <group>network_scan,mitre_discovery,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1110 — Brute Force (EventID 4625)                          -->
  <!-- ============================================================ -->
  <rule id="100110" level="6">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4625$</field>
    <description>Sigma T1110: Failed logon attempt — $(win.eventdata.targetUserName)</description>
    <group>authentication_failed,mitre_credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100111" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_source_ip />
    <description>Sigma T1110: Multiple failed logon attempts from the same source — brute force</description>
    <group>authentication_failures,mitre_credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1059.001 — PowerShell Execution                             -->
  <!-- ============================================================ -->
  <rule id="100120" level="8">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)powershell\.exe</field>
    <description>Sigma T1059.001: PowerShell process created — $(win.eventdata.commandLine)</description>
    <group>powershell,mitre_execution,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100121" level="12">
    <if_sid>100120</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-EncodedCommand|IEX|DownloadString|-bypass)</field>
    <description>Sigma T1059.001: PowerShell with suspicious parameters (encoded/download cradle/bypass)</description>
    <group>powershell,mitre_execution,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- 91802 = base ruleset parent for PowerShell/Operational Script Block
       events (EventID 4104). Chaining on it guarantees scriptBlockText is
       decoded; an <if_group> on a non-existent group silently never matches. -->
  <rule id="100131" level="12">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(-EncodedCommand|FromBase64String|IEX|Invoke-Expression)</field>
    <description>Sigma T1059.001: PowerShell ScriptBlock with suspicious content</description>
    <group>powershell,mitre_execution,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1027 — Obfuscated Files or Information                      -->
  <!-- ============================================================ -->
  <rule id="100127" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(FromBase64String|[A-Za-z0-9+/]{100,}={0,2})</field>
    <description>Sigma T1027: Base64-encoded pattern in command line — possible obfuscation</description>
    <group>obfuscation,mitre_defense_evasion,</group>
    <mitre>
      <id>T1027</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1003 — Credential Dumping (Sysmon EventID 10 — LSASS access) -->
  <!-- ============================================================ -->
  <rule id="100103" level="14">
    <if_group>sysmon_event10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">^(0x1010|0x1410)$</field>
    <description>Sigma T1003: Suspicious access to LSASS memory — possible credential dumping</description>
    <group>credential_dumping,mitre_credential_access,</group>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1547.001 — Registry Run Keys / Startup Folder                -->
  <!-- ============================================================ -->
  <rule id="100147" level="9">
    <if_group>sysmon_event13,sysmon_event14</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(CurrentVersion\\Run|Winlogon\\Shell)</field>
    <description>Sigma T1547.001: Registry autostart persistence — $(win.eventdata.targetObject)</description>
    <group>persistence,mitre_persistence,</group>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1021.002 — Remote Services: SMB/Admin Shares                -->
  <!-- Root cause fixed 2026-09-14/16: exclude machine accounts ($) -->
  <!-- and ANONYMOUS LOGON — both are routine GPO/Netlogon noise    -->
  <!-- ============================================================ -->
  <rule id="100139" level="3">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^5140$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)(ADMIN\$|C\$|IPC\$)</field>
    <field name="win.eventdata.subjectUserName" type="pcre2">(?i)(\$$|^ANONYMOUS LOGON$)</field>
    <description>Routine machine-account/anonymous access to admin share — noise, not alerted</description>
    <group>lateral_movement_noise,</group>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <rule id="100140" level="10">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^5140$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)(ADMIN\$|C\$|IPC\$)</field>
    <field name="win.eventdata.subjectUserName" type="pcre2" negate="yes">(?i)(\$$|^ANONYMOUS LOGON$)</field>
    <description>Sigma T1021.002: Real account accessed an admin share — possible lateral movement — $(win.eventdata.subjectUserName) from $(win.eventdata.ipAddress)</description>
    <group>lateral_movement,mitre_lateral_movement,</group>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1055 — Process Injection (Sysmon EventID 8 — CreateRemoteThread) -->
  <!-- ============================================================ -->
  <rule id="100155" level="13">
    <if_group>sysmon_event8</if_group>
    <description>Sigma T1055: CreateRemoteThread into another process — possible process injection — $(win.eventdata.sourceImage) -> $(win.eventdata.targetImage)</description>
    <group>process_injection,mitre_defense_evasion,</group>
    <mitre>
      <id>T1055</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1053.005 — Scheduled Task (EventID 4698/4702)                -->
  <!-- Requires Windows audit subcategory "Other Object Access      -->
  <!-- Events" enabled — see detection sheet for auditpol command    -->
  <!-- ============================================================ -->
  <rule id="100153" level="9">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID" type="pcre2">^(4698|4702)$</field>
    <description>Sigma T1053: Scheduled task created/modified — $(win.eventdata.taskName)</description>
    <group>persistence,mitre_persistence,</group>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1078 — Valid Accounts (privileged remote logon)              -->
  <!-- ============================================================ -->
  <rule id="100178" level="9">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType" type="pcre2">^(3|10)$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)(administrator|admin|svc_)</field>
    <description>Sigma T1078: Privileged account remote logon — $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <group>privileged_logon,mitre_privilege_escalation,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1546.013 — PowerShell Profile (FIM)                          -->
  <!-- Requires FIM directories covering System32\WindowsPowerShell -->
  <!-- and Documents\WindowsPowerShell — see agent.conf              -->
  <!-- ============================================================ -->
  <rule id="100186" level="8">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)(Microsoft\.PowerShell_profile\.ps1|profile\.ps1)</field>
    <description>Sigma T1546.013: PowerShell profile modified — possible persistence</description>
    <group>persistence,powershell,mitre_persistence,</group>
    <mitre>
      <id>T1546.013</id>
    </mitre>
  </rule>

</group>

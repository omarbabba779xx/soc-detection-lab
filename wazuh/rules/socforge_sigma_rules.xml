<!-- SocForge Custom Wazuh Rules — Phase 2 Detection -->
<!-- Deployed on VM02-WAZUH: /var/ossec/etc/rules/socforge_sigma_rules.xml -->
<!-- Based on Sigma rules converted for Wazuh + Windows/Sysmon -->

<group name="socforge_purple,">

  <!-- ============================================================ -->
  <!-- T1046 — Network Service Discovery (Sysmon EventID 3)        -->
  <!-- ============================================================ -->
  <rule id="100101" level="8">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.destinationPort" type="pcre2">^(21|22|23|25|53|80|110|139|143|443|445|3306|3389|5985|8080|8443)$</field>
    <description>Sigma T1046: Network Service Scanning — $(win.eventdata.image) → $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description>
    <group>network_scan,mitre_discovery,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100101</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(nmap|masscan|zmap|arp-scan|nbtscan)</field>
    <description>Sigma T1046: Known scanning tool detected — $(win.eventdata.image)</description>
    <group>network_scan,mitre_discovery,high_confidence,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- T1110 — Brute Force (EventID 4625)                          -->
  <!-- ============================================================ -->
  <rule id="100110" level="6">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4625$</field>
    <description>Sigma T1110: Authentication failure — $(win.eventdata.targetUserName) from $(win.eventdata.workstationName)</description>
    <group>authentication_failed,mitre_credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100111" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Sigma T1110: Brute force — 5+ failures in 60s on $(win.eventdata.targetUserName)</description>
    <group>brute_force,mitre_credential_access,high_confidence,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1059.001 — PowerShell Execution (EventID 4103/4104/4688)   -->
  <!-- ============================================================ -->
  <rule id="100120" level="8">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)powershell(\.exe)?$</field>
    <description>Sigma T1059.001: PowerShell execution — $(win.eventdata.commandLine)</description>
    <group>powershell,mitre_execution,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100121" level="12">
    <if_sid>100120</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-encodedcommand|iex|invoke-expression|downloadstring|frombase64string)</field>
    <description>Sigma T1059.001: PowerShell encoded/obfuscated command — $(win.eventdata.commandLine)</description>
    <group>powershell,obfuscation,mitre_execution,high_confidence,</group>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>

  <rule id="100131" level="12">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4104$</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(invoke-mimikatz|invoke-shellcode|powersploit|empire|cobalt|meterpreter)</field>
    <description>Sigma T1059.001: Malicious PowerShell script block detected</description>
    <group>powershell,credential_dumping,mitre_execution,critical,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1027 — Obfuscated Files/Information                        -->
  <!-- ============================================================ -->
  <rule id="100127" level="10">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(frombase64string|[a-zA-Z0-9+/]{100,}={0,2})</field>
    <description>Sigma T1027: Base64-encoded command in process arguments</description>
    <group>obfuscation,mitre_defense_evasion,</group>
    <mitre>
      <id>T1027</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1078 — Valid Accounts (after-hours logon)                  -->
  <!-- ============================================================ -->
  <rule id="100178" level="9">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType" type="pcre2">^(3|10)$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)(administrator|admin|svc_)</field>
    <description>Sigma T1078: Privileged account remote logon — $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <group>privileged_logon,mitre_privilege_escalation,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1021.002 — Remote Services: SMB/Admin Shares              -->
  <!-- ============================================================ -->
  <rule id="100139" level="3">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^5140$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)(ADMIN\$|C\$|IPC\$)</field>
    <field name="win.eventdata.subjectUserName" type="pcre2">(?i)\$$</field>
    <description>Admin share access by machine account — routine Windows/GPO/WMI background traffic, not lateral movement</description>
    <group>lateral_movement_noise,</group>
  </rule>

  <rule id="100140" level="10">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^5140$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)(ADMIN\$|C\$|IPC\$)</field>
    <field name="win.eventdata.subjectUserName" type="pcre2" negate="yes">(?i)\$$</field>
    <description>Sigma T1021.002: Admin share access by non-machine account — possible lateral movement via $(win.eventdata.shareName)</description>
    <group>lateral_movement,mitre_lateral_movement,</group>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1003 — Credential Dumping (LSASS access via Sysmon 10)    -->
  <!-- ============================================================ -->
  <rule id="100103" level="14">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <description>Sigma T1003: LSASS memory access — possible credential dumping by $(win.eventdata.sourceImage)</description>
    <group>credential_dumping,mitre_credential_access,critical,</group>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1547 — Boot/Logon Autostart (Registry Run Keys)           -->
  <!-- ============================================================ -->
  <rule id="100147" level="9">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID" type="pcre2">^(13|14)$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(CurrentVersion\\Run|RunOnce|Winlogon|AppInit_DLLs)</field>
    <description>Sigma T1547: Registry autostart persistence — $(win.eventdata.targetObject)</description>
    <group>persistence,mitre_persistence,</group>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1053 — Scheduled Task/Job (EventID 4698/4702)             -->
  <!-- ============================================================ -->
  <rule id="100153" level="9">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID" type="pcre2">^(4698|4702)$</field>
    <description>Sigma T1053: Scheduled task created/modified — $(win.eventdata.taskName)</description>
    <group>persistence,mitre_persistence,</group>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1055 — Process Injection (CreateRemoteThread via Sysmon 8)-->
  <!-- ============================================================ -->
  <rule id="100155" level="13">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^8$</field>
    <description>Sigma T1055: CreateRemoteThread — $(win.eventdata.sourceImage) → $(win.eventdata.targetImage)</description>
    <group>process_injection,mitre_privilege_escalation,critical,</group>
    <mitre>
      <id>T1055</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1086 — PowerShell (legacy alias, same as T1059.001)       -->
  <!-- Wazuh FIM rule for PowerShell profile modification          -->
  <!-- ============================================================ -->
  <rule id="100186" level="8">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)(Microsoft\.PowerShell_profile\.ps1|profile\.ps1)</field>
    <description>Sigma T1086: PowerShell profile modified — possible persistence</description>
    <group>persistence,powershell,mitre_persistence,</group>
    <mitre>
      <id>T1546.013</id>
    </mitre>
  </rule>

</group>

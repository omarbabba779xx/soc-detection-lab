<!-- SocForge Custom Wazuh Rules — Linux endpoints -->
<!-- Deployed on VM02-WAZUH: /var/ossec/etc/rules/socforge_linux_rules.xml -->
<!-- These rules are live on the deployed Wazuh instance (confirmed via direct query
     of /var/ossec/logs/alerts/alerts.json and Wazuh Threat Hunting) but were missing
     from the repo's tracked rules files until this audit — added to close that gap. -->

<group name="socforge_purple,">

  <!-- ============================================================ -->
  <!-- T1548.003 — Sudo Privilege Escalation (Linux auditd/syslog)  -->
  <!-- ============================================================ -->
  <rule id="100200" level="10">
    <if_sid>5402</if_sid>
    <description>Sigma T1548.003: Sudo privilege escalation - user executed sudo as ROOT</description>
    <group>privilege_escalation,mitre_privilege_escalation,socforge_purple,</group>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- T1053.003 — Cron Persistence (Linux syslog)                  -->
  <!-- ============================================================ -->
  <rule id="100210" level="10">
    <if_sid>2832</if_sid>
    <description>Sigma T1053.003: Cron persistence - crontab entry modified by user</description>
    <group>persistence,mitre_persistence,socforge_purple,</group>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>

</group>

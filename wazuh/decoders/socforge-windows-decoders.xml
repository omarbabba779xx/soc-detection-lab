<!-- SocForge Custom Wazuh Decoders — Windows -->
<!-- Deployed on VM02-WAZUH: /var/ossec/etc/decoders/socforge-windows-decoders.xml -->

<decoder_list>

  <!-- ============================================================ -->
  <!-- DECODER: Sysmon EventID 1 — Process Creation                 -->
  <!-- ============================================================ -->
  <decoder name="sysmon-event1">
    <parent>json</parent>
    <type>event</type>
    <use_own_name>yes</use_own_name>
    <prematch offset="after_parent">\"EventID\":\"?1\"?</prematch>
    <regex offset="after_parent">\"Image\":\"([^\"]+)\"</regex>
    <order>win.eventdata.image</order>
  </decoder>

  <decoder name="sysmon-event1-cmdline">
    <parent>sysmon-event1</parent>
    <use_own_name>yes</use_own_name>
    <regex>\"CommandLine\":\"([^\"]+)\"</regex>
    <order>win.eventdata.commandLine</order>
  </decoder>

  <decoder name="sysmon-event1-parent">
    <parent>sysmon-event1</parent>
    <use_own_name>yes</use_own_name>
    <regex>\"ParentImage\":\"([^\"]+)\"</regex>
    <order>win.eventdata.parentImage</order>
  </decoder>

  <!-- ============================================================ -->
  <!-- DECODER: Windows EventID 4625 — Logon Failure                -->
  <!-- ============================================================ -->
  <decoder name="win-4625">
    <parent>json</parent>
    <use_own_name>yes</use_own_name>
    <prematch offset="after_parent">\"EventID\":\"?4625\"?</prematch>
    <regex>\"TargetUserName\":\"([^\"]+)\"</regex>
    <order>win.eventdata.targetUserName</order>
  </decoder>

  <decoder name="win-4625-src">
    <parent>win-4625</parent>
    <use_own_name>yes</use_own_name>
    <regex>\"IpAddress\":\"([^\"]+)\"</regex>
    <order>win.eventdata.ipAddress</order>
  </decoder>

  <decoder name="win-4625-workstation">
    <parent>win-4625</parent>
    <use_own_name>yes</use_own_name>
    <regex>\"WorkstationName\":\"([^\"]+)\"</regex>
    <order>win.eventdata.workstationName</order>
  </decoder>

  <!-- ============================================================ -->
  <!-- DECODER: Windows EventID 4688 — Process Creation             -->
  <!-- ============================================================ -->
  <decoder name="win-4688">
    <parent>json</parent>
    <use_own_name>yes</use_own_name>
    <prematch offset="after_parent">\"EventID\":\"?4688\"?</prematch>
    <regex>\"NewProcessName\":\"([^\"]+)\"</regex>
    <order>win.eventdata.newProcessName</order>
  </decoder>

  <decoder name="win-4688-cmdline">
    <parent>win-4688</parent>
    <use_own_name>yes</use_own_name>
    <regex>\"CommandLine\":\"([^\"]+)\"</regex>
    <order>win.eventdata.commandLine</order>
  </decoder>

  <!-- ============================================================ -->
  <!-- DECODER: Windows EventID 5140 — Network Share Access         -->
  <!-- ============================================================ -->
  <decoder name="win-5140">
    <parent>json</parent>
    <use_own_name>yes</use_own_name>
    <prematch offset="after_parent">\"EventID\":\"?5140\"?</prematch>
    <regex>\"ShareName\":\"([^\"]+)\"</regex>
    <order>win.eventdata.shareName</order>
  </decoder>

  <decoder name="win-5140-ip">
    <parent>win-5140</parent>
    <use_own_name>yes</use_own_name>
    <regex>\"IpAddress\":\"([^\"]+)\"</regex>
    <order>win.eventdata.ipAddress</order>
  </decoder>

  <!-- ============================================================ -->
  <!-- DECODER: OPNsense Firewall Syslog                            -->
  <!-- ============================================================ -->
  <decoder name="opnsense-fw">
    <program_name>filterlog</program_name>
    <regex>(\d+),(\d+),,(\w+),(\w+),(in|out),(6|4),(\d+),</regex>
    <order>id, rule_number, tracker, interface, reason, direction, ip_version, protocol</order>
  </decoder>

  <decoder name="opnsense-fw-ipv4">
    <parent>opnsense-fw</parent>
    <use_own_name>yes</use_own_name>
    <prematch offset="after_parent">,(\d+\.\d+\.\d+\.\d+),(\d+\.\d+\.\d+\.\d+),(\d+)</prematch>
    <regex offset="after_parent">,(\d+\.\d+\.\d+\.\d+),(\d+\.\d+\.\d+\.\d+),</regex>
    <order>src_ip, dst_ip</order>
  </decoder>

</decoder_list>
